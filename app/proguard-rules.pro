# Правила сокращения кода для release.
# Пока модуль минимальный, специфичных правил нет.

# Room генерирует классы через KSP, их имена используются рефлексией.
-keep class dev.blooapp.data.** { *; }

# Сохраняем имена наших диагностических кодов: они уходят в отчёт как строки,
# и обфускация сделала бы отчёт бесполезным.
-keepclassmembers enum dev.webapps.diag.** { *; }
