<?xml version="1.0" encoding="utf-8"?>
<!--
  Что попадает в облачный бэкап.

  Список веб-приложений и их настройки — попадают: это то, что пользователь
  сам создал, и терять при смене устройства обидно.

  Cookies и данные сайтов НЕ попадают: они лежат в каталоге WebView
  (app_webview), и восстанавливать чужие сессии на другом устройстве —
  и небезопасно, и бессмысленно (сессия привязана к устройству).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="blooapp.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="app_webview" />
        <exclude domain="file" path="diag" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="blooapp.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
