<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".BlooApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/backup_rules_v11"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Blooapp"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.ManagerActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Окно веб-приложения.

          launchMode="standard" + documentLaunchMode="intoExisting" даёт
          «одна задача на веб-приложение»: повторный тап по ярлыку возвращает
          в то же окно, а в «Недавних» каждое приложение — отдельная карточка.
          documentLaunchMode работает ТОЛЬКО при launchMode="standard"
          (проверено в документации по экрану «Недавние»).

          Осознанно НЕ выставляем:
           - android:screenOrientation — на targetSdk 36 игнорируется на
             экранах >= 600dp;
           - широкий android:configChanges — вместо него saveState/restoreState,
             иначе на adaptive layouts поведение непредсказуемо.
        -->
        <activity
            android:name=".ui.WebAppHostActivity"
            android:configChanges="uiMode|keyboardHidden"
            android:documentLaunchMode="intoExisting"
            android:exported="false"
            android:launchMode="standard"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
